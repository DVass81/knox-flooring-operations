# Required application settings
PORT=8080
DATABASE_URL=postgresql://user:password@host:25060/database?sslmode=require
APP_BASE_URL=http://localhost:8080
DEMO_ACCESS_ENABLED=false

# First owner (only used when the users table is empty)
OWNER_EMAIL=owner@example.com
OWNER_INITIAL_PASSWORD=replace-with-at-least-12-characters
OWNER_NAME=Knox Flooring Owner

# Executive demo and safe communications
DEMO_MODE=true
# Used only when DEMO_MODE=false. Comma-separated test recipients.
COMMS_ALLOWLIST=

# AI Quote Copilot (deterministic fallback remains available without a key)
OPENAI_API_KEY=
OPENAI_ESTIMATOR_MODEL=gpt-5.6-terra
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin

# Tutorial narration (ElevenLabs preferred; OpenAI above is the automatic fallback)
TUTORIAL_TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
# Select or design a young male teaching voice in ElevenLabs and paste its voice ID here.
# When the ID is blank, the app looks up the young, friendly Adam tutorial voice.
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_NAME=Adam - Engaging, Friendly and Bright
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_VOICE_STABILITY=0.48
ELEVENLABS_VOICE_SIMILARITY=0.78
ELEVENLABS_VOICE_STYLE=0.32
ELEVENLABS_VOICE_SPEED=0.96

# Password reset email
RESEND_API_KEY=
RESEND_FROM_EMAIL=Knox Ops <noreply@example.com>

# QuickBooks Online / Intuit Developer app
QUICKBOOKS_ENVIRONMENT=sandbox
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=http://localhost:8080/api/quickbooks/callback
QUICKBOOKS_WEBHOOK_VERIFIER=
# A long random secret used to encrypt OAuth tokens at rest; do not rotate without reconnecting.
QUICKBOOKS_ENCRYPTION_KEY=
